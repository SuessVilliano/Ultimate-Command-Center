# LIV8 Command Center Frontend Configuration
# Copy this to .env and fill in your values

# API Server URL (without https:// prefix)
# For production, set this to your deployed server domain
# Leave empty for localhost development
VITE_API_URL=

# LIV8 Command Center remote MCP gateway — SERVER SIDE ONLY.
# Public origin of the deployed Express API; no trailing slash.
LIV8_MCP_PUBLIC_BASE_URL=
# Long random signing secret used for OAuth codes/tokens. Never expose through VITE_.
LIV8_MCP_AUTH_SECRET=
# Password shown only on the private LIV8 OAuth consent screen.
LIV8_MCP_OWNER_PASSWORD=
# Optional trusted machine-to-machine Bearer key for OpenClaw/private gateways.
LIV8_MCP_API_KEY=
# Optional comma-separated OAuth Client ID Metadata hosts. Empty allows validated public HTTPS CIMD clients.
LIV8_MCP_ALLOWED_CLIENT_HOSTS=
COMMAND_CENTER_TIMEZONE=America/New_York

# MCP live trading — SERVER SIDE ONLY.
# Live orders remain double-gated: liv8.write scope + CONFIRM_LIVE_TRADE per call.
LIV8_MCP_LIVE_TRADING_ENABLED=false
# Optional comma-separated broker allowlist. Examples: kraken,ctrader,hybrid-journal
# When set, live execution requires the request to name an allowed broker.
LIV8_MCP_LIVE_TRADING_BROKERS=kraken,ctrader,hybrid-journal

# Hybrid Execution Gateway — SERVER SIDE ONLY.
# Never expose HYBRID_EXECUTION_API_KEY through a VITE_ variable or browser bundle.
HYBRID_EXECUTION_URL=https://hybridzone-api.onrender.com
HYBRID_EXECUTION_API_KEY=

# Creator Control Room app compartments.
# Use HTTPS/tunnel URLs in production, or distinct local ports on the Mac mini.
VITE_OBS_REMOTE_URL=http://localhost:3101
VITE_CLIPPEDIT_URL=http://localhost:3102

# PersonaPlex Voice AI Server (host:port, no protocol prefix)
# Requires NVIDIA GPU server running PersonaPlex on port 8998
# Can also be overridden via ?worker_addr= query parameter in the browser
VITE_PERSONAPLEX_SERVER=
