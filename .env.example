# LIV8 Command Center Frontend Configuration
# Copy this to .env and fill in your values

# API Server URL (without https:// prefix)
VITE_API_URL=

# LIV8 Command Center remote MCP gateway — SERVER SIDE ONLY.
LIV8_MCP_PUBLIC_BASE_URL=
LIV8_MCP_AUTH_SECRET=
LIV8_MCP_OWNER_PASSWORD=
LIV8_MCP_API_KEY=
LIV8_MCP_ALLOWED_CLIENT_HOSTS=
COMMAND_CENTER_TIMEZONE=America/New_York

# MCP live trading — SERVER SIDE ONLY.
# Live capital actions require the authenticated MCP write surface plus the
# explicit CONFIRM_LIVE_TRADE value on every capital-moving call.
LIV8_MCP_LIVE_TRADING_ENABLED=false
# Direct + federated targets. Tradovate/NinjaTrader routes normalize to CrossTrade.
LIV8_MCP_LIVE_TRADING_BROKERS=kraken,crosstrade,tradovate,ctrader,hybrid-journal

# Dedicated Hybrid Trading MCP federation.
# This server handles CrossTrade/NinjaTrader futures + Kraken + Journal/Copy/Funding tools.
HYBRID_TRADING_MCP_URL=https://hybrid-mcp-server.onrender.com/mcp
# Must match HYBRID_MCP_GATEWAY_TOKEN on the Hybrid Trading MCP Render service.
HYBRID_TRADING_MCP_TOKEN=
HYBRID_TRADING_MCP_MAX_ORDER_QTY=5
HYBRID_TRADING_MCP_KILL_SWITCH=0

# Hybrid Execution Gateway — direct normalized broker execution.
HYBRID_EXECUTION_URL=https://hybridzone-v2.onrender.com
HYBRID_EXECUTION_API_KEY=

# Optional provider credentials forwarded to Hybrid Trading MCP when set locally.
# If omitted, a private single-tenant Hybrid Trading MCP may use its own server env.
CROSSTRADE_TOKEN=
CROSSTRADE_ACCOUNT=
CROSSTRADE_BASE_URL=https://app.crosstrade.io/v1/api
HYBRID_JOURNAL_URL=https://hybridjournal.co
JOURNAL_API_KEY=
HYBRID_COPY_WEBHOOK_URL=
HYBRID_FUNDING_URL=
HYBRID_FUNDING_API_KEY=

# Creator Control Room app compartments.
VITE_OBS_REMOTE_URL=http://localhost:3101
VITE_CLIPPEDIT_URL=http://localhost:3102

# PersonaPlex Voice AI Server (host:port, no protocol prefix)
VITE_PERSONAPLEX_SERVER=
