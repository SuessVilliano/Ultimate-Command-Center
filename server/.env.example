# LIV8 AI Server Configuration
# =============================
# Copy this file to .env and fill in your API keys

# Local AI — preferred on the Mac mini. No API key / no per-token cost.
# The Command Center local bridge talks to Ollama on this machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_FAST_MODEL=gemma3:4b
LOCAL_AI_FIRST=true
ALLOW_PAID_AI_FALLBACK=false

# Legacy cloud AI provider. Keep keys optional; local AI should handle routine work.
AI_PROVIDER=gemini

# Anthropic (Claude) Configuration
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI (GPT) Configuration
OPENAI_API_KEY=
GPT_MODEL=gpt-4o

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Kimi / NVIDIA NIM API Configuration
KIMI_API_KEY=
NVIDIA_API_KEY=
VOXCPM_BASE_URL=

PORT=3005

# Local Mac workspace MCP server.
# Allow only work folders; never point this at /Users/liv8 or the full disk.
LOCAL_WORKSPACE_ENABLED=true
LOCAL_WORKSPACE_WRITE_ENABLED=true
LOCAL_WORKSPACE_ROOTS=~/clawd,~/Documents/LIV8
LOCAL_WORKSPACE_MAX_READ_BYTES=1000000
LOCAL_MCP_PROTOCOL_VERSION=2025-06-18

FRESHDESK_DOMAIN=your_freshdesk_domain
FRESHDESK_API_KEY=your_freshdesk_api_key
FRESHDESK_AGENT_ID=your_agent_id

SCHEDULE_ENABLED=true
SCHEDULE_TIMEZONE=America/New_York
SCHEDULE_MORNING=0 8 * * *
SCHEDULE_NOON=0 12 * * *
SCHEDULE_AFTERNOON=0 16 * * *
SCHEDULE_MIDNIGHT=0 0 * * *

PROACTIVE_AI_ENABLED=true
PROACTIVE_CHECK_INTERVAL=30
PROACTIVE_AUTO_ACTIONS=false

TASKMAGIC_WEBHOOK_URL=your_taskmagic_webhook_url
N8N_WEBHOOK_URL=
TASKMAGIC_MCP_TOKEN=

GOOGLE_CALENDAR_EMAIL=your_email@gmail.com
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TASKADE_API_KEY=
GHL_API_KEY=
GHL_LOCATION_ID=

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Nifty legacy REST/OAuth fallback
NIFTY_CLIENT_ID=
NIFTY_CLIENT_SECRET=
NIFTY_REDIRECT_URI=https://your-app.com/api/nifty/callback
NIFTY_ACCESS_TOKEN=
NIFTY_REFRESH_TOKEN=

# Nifty MCP — preferred headless operating layer.
NIFTY_MCP_URL=
NIFTY_MCP_TOKEN=
NIFTY_MCP_PROTOCOL_VERSION=2025-06-18

RAPIDAPI_KEY=
APIFY_API_KEY=

# Hybrid Journal REST fallback
HYBRID_JOURNAL_API_KEY=

# Hybrid Journal MCP — canonical trading intelligence/execution bridge.
HYBRID_JOURNAL_MCP_URL=
HYBRID_JOURNAL_MCP_TOKEN=
HYBRID_JOURNAL_MCP_PROTOCOL_VERSION=2025-06-18

# Apple Health bridge — bearer token used by the iPhone HealthKit shortcut/app.
# Generate a long random secret and keep it server-side + on the iPhone only.
APPLE_HEALTH_INGEST_TOKEN=

# Oura recovery provider
OURA_ACCESS_TOKEN=

# Juno Gateway — shared authenticated command surface for Command Center,
# Telegram/OpenClaw, voice, and Siri Shortcut. Generate a long random secret.
JUNO_GATEWAY_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_JUNO_CHAT_ID=
TELEGRAM_SIGNALS_CHAT_ID=
TELEGRAM_KRAKEN_CHAT_ID=
TELEGRAM_COMMUNITY_CHAT_ID=

VILOUD_RTMP_URL=rtmp://broadcast.viloud.tv/in/
VILOUD_STREAM_KEY=
GOKOLLAB_RTMP_URL=
GOKOLLAB_STREAM_KEY=
YOUTUBE_STREAM_KEY=
TWITCH_STREAM_KEY=
FACEBOOK_STREAM_KEY=

DATABASE_PATH=./data/liv8.db
