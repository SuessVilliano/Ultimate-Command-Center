# LIV8 AI Server Configuration
# =============================
# Copy this file to .env and fill in your API keys

# Primary AI Provider (gemini recommended — free; claude used auto for code tasks)
AI_PROVIDER=gemini

# Anthropic (Claude) Configuration
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI (GPT) Configuration - Add your key to enable GPT
OPENAI_API_KEY=
GPT_MODEL=gpt-4o

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq Configuration (FREE - Llama 3.3, Mixtral, Gemma)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Kimi / NVIDIA NIM API Configuration
KIMI_API_KEY=
NVIDIA_API_KEY=
VOXCPM_BASE_URL=

PORT=3005

FRESHDESK_DOMAIN=your_freshdesk_domain
FRESHDESK_API_KEY=your_freshdesk_api_key
FRESHDESK_AGENT_ID=your_agent_id

SCHEDULE_ENABLED=true
SCHEDULE_TIMEZONE=America/New_York
SCHEDULE_MORNING=0 8 * * *
SCHEDULE_NOON=0 12 * * *
SCHEDULE_AFTERNOON=0 16 * * *
SCHEDULE_MIDNIGHT=0 0 * * *

PROACTIVE_AI_ENABLED=true
PROACTIVE_CHECK_INTERVAL=30
PROACTIVE_AUTO_ACTIONS=false

TASKMAGIC_WEBHOOK_URL=your_taskmagic_webhook_url
N8N_WEBHOOK_URL=
TASKMAGIC_MCP_TOKEN=your_taskmagic_token

GOOGLE_CALENDAR_EMAIL=your_email@gmail.com
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TASKADE_API_KEY=
GHL_API_KEY=
GHL_LOCATION_ID=

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Nifty legacy REST/OAuth fallback
NIFTY_CLIENT_ID=your_client_id
NIFTY_CLIENT_SECRET=your_client_secret
NIFTY_REDIRECT_URI=https://your-app.com/api/nifty/callback
NIFTY_ACCESS_TOKEN=
NIFTY_REFRESH_TOKEN=

# Nifty MCP — preferred headless operating layer.
# Keep these server-side only. The Command Center discovers tools dynamically.
NIFTY_MCP_URL=
NIFTY_MCP_TOKEN=
NIFTY_MCP_PROTOCOL_VERSION=2025-06-18

RAPIDAPI_KEY=
APIFY_API_KEY=
HYBRID_JOURNAL_API_KEY=your_hj_api_key

TELEGRAM_BOT_TOKEN=
TELEGRAM_JUNO_CHAT_ID=
TELEGRAM_SIGNALS_CHAT_ID=
TELEGRAM_KRAKEN_CHAT_ID=
TELEGRAM_COMMUNITY_CHAT_ID=

VILOUD_RTMP_URL=rtmp://broadcast.viloud.tv/in/
VILOUD_STREAM_KEY=your_viloud_stream_key
GOKOLLAB_RTMP_URL=your_gokollab_rtmp_url
GOKOLLAB_STREAM_KEY=your_gokollab_stream_key
YOUTUBE_STREAM_KEY=
TWITCH_STREAM_KEY=
FACEBOOK_STREAM_KEY=

DATABASE_PATH=./data/liv8.db
