# LIV8 AI Server Configuration
# =============================
# Copy this file to .env and fill in your API keys

# Local AI — preferred on the Mac mini. No API key / no per-token cost.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_FAST_MODEL=gemma3:4b
LOCAL_AI_FIRST=true
ALLOW_PAID_AI_FALLBACK=false
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
GPT_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
KIMI_API_KEY=
NVIDIA_API_KEY=
VOXCPM_BASE_URL=

PORT=3005

# Local Mac workspace MCP server.
LOCAL_WORKSPACE_ENABLED=true
LOCAL_WORKSPACE_WRITE_ENABLED=true
LOCAL_WORKSPACE_ROOTS=~/clawd,~/Documents/LIV8
LOCAL_WORKSPACE_MAX_READ_BYTES=1000000
LOCAL_MCP_PROTOCOL_VERSION=2025-06-18

FRESHDESK_DOMAIN=your_freshdesk_domain
FRESHDESK_API_KEY=your_freshdesk_api_key
FRESHDESK_AGENT_ID=your_agent_id

SCHEDULE_ENABLED=true
SCHEDULE_TIMEZONE=America/New_York
SCHEDULE_MORNING=0 8 * * *
SCHEDULE_NOON=0 12 * * *
SCHEDULE_AFTERNOON=0 16 * * *
SCHEDULE_MIDNIGHT=0 0 * * *

PROACTIVE_AI_ENABLED=true
PROACTIVE_CHECK_INTERVAL=30
PROACTIVE_AUTO_ACTIONS=false

# Existing TaskMagic webhook support
TASKMAGIC_WEBHOOK_URL=
N8N_WEBHOOK_URL=
TASKMAGIC_MCP_TOKEN=

# Connected Ops gateway — use ONE of these modes.
# Bridge mode: point at a TaskMagic/Composio/custom HTTP bridge that accepts
# { action: 'gmail.list'|'gmail.send'|'calendar.list'|'calendar.create', args: {...} }
CONNECTOR_BRIDGE_URL=
CONNECTOR_BRIDGE_KEY=
# Direct MCP mode: point at a streamable-HTTP MCP server. Tool names are provider-specific.
CONNECTOR_MCP_URL=
CONNECTOR_MCP_TOKEN=
CONNECTOR_MCP_HEADERS_JSON={}
CONNECTOR_GMAIL_LIST_TOOL=
CONNECTOR_GMAIL_SEND_TOOL=
CONNECTOR_CALENDAR_LIST_TOOL=
CONNECTOR_CALENDAR_CREATE_TOOL=

# Optional raw Twilio fallback only. LeadConnector/HighLevel-owned numbers should use
# the HighLevel Conversations API below instead of requiring Twilio credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Optional direct Google OAuth fallback. The connector gateway above can be used instead.
GOOGLE_CLIENT_ID=
GOOGLE_CALENDAR_EMAIL=your_email@gmail.com

ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TASKADE_API_KEY=

# LIV8 Connect / HighLevel Private Integration
# Primary source for CRM contacts plus LeadConnector SMS + WhatsApp Conversations.
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
# Set in E.164 format (example: +18135551212). Used as the outbound LC business line.
GHL_PRIMARY_PHONE_NUMBER=
HIGHLEVEL_API_BASE=https://services.leadconnectorhq.com
GHL_API_KEY=
GHL_AFFILIATE_SANDBOX_PIT=
GHL_AFFILIATE_SANDBOX_LOCATION_ID=
GHL_AFFILIATE_SANDBOX_FORM_ID=

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Nifty legacy REST/OAuth fallback
NIFTY_CLIENT_ID=
NIFTY_CLIENT_SECRET=
NIFTY_REDIRECT_URI=https://your-app.com/api/nifty/callback
NIFTY_ACCESS_TOKEN=
NIFTY_REFRESH_TOKEN=

# Nifty MCP — preferred headless operating layer.
NIFTY_MCP_URL=
NIFTY_MCP_TOKEN=
NIFTY_MCP_PROTOCOL_VERSION=2025-06-18

RAPIDAPI_KEY=
APIFY_API_KEY=
HYBRID_JOURNAL_API_KEY=
HYBRID_JOURNAL_MCP_URL=
HYBRID_JOURNAL_MCP_TOKEN=
HYBRID_JOURNAL_MCP_PROTOCOL_VERSION=2025-06-18

APPLE_HEALTH_INGEST_TOKEN=
OURA_ACCESS_TOKEN=

JUNO_GATEWAY_KEY=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
OBS_BRIDGE_URL=
OBS_BRIDGE_KEY=

# Legacy write adapters retained for compatibility; Juno now prefers Connected Ops routes.
CALENDAR_WRITE_ADAPTER_URL=
CALENDAR_WRITE_ADAPTER_KEY=
GMAIL_SEND_ADAPTER_URL=
GMAIL_SEND_ADAPTER_KEY=
GITHUB_WRITE_ADAPTER_URL=
GITHUB_WRITE_ADAPTER_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_JUNO_CHAT_ID=
TELEGRAM_SIGNALS_CHAT_ID=
TELEGRAM_KRAKEN_CHAT_ID=
TELEGRAM_COMMUNITY_CHAT_ID=

VILOUD_RTMP_URL=rtmp://broadcast.viloud.tv/in/
VILOUD_STREAM_KEY=
GOKOLLAB_RTMP_URL=
GOKOLLAB_STREAM_KEY=
YOUTUBE_STREAM_KEY=
TWITCH_STREAM_KEY=
FACEBOOK_STREAM_KEY=

DATABASE_PATH=./data/liv8.db
TASKMAGIC_AFFILIATE_WEBHOOK_URL=
