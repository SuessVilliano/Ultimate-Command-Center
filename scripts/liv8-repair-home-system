#!/bin/bash
set -u

ROOT="${LIV8_ROOT:-$HOME/clawd}"
UCC="$ROOT/Ultimate-Command-Center"
LOGROOT="$HOME/.liv8/logs"
mkdir -p "$LOGROOT"

ok(){ printf '✅ %s\n' "$*"; }
warn(){ printf '⚠️  %s\n' "$*"; }
info(){ printf '→ %s\n' "$*"; }
port_up(){ lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }
wait_port(){ local p="$1"; local n="${2:-30}"; for _ in $(seq 1 "$n"); do port_up "$p" && return 0; sleep .5; done; return 1; }

printf '\n🛠️  LIV8 HOME SYSTEM REPAIR\n\n'

if [[ ! -d "$UCC/.git" ]]; then
  warn "Ultimate Command Center repo not found at $UCC"
  exit 1
fi

info "Updating Ultimate Command Center"
git -C "$UCC" pull --ff-only origin master || warn "Update skipped because the repo has local changes"

if [[ -f "$UCC/package.json" ]]; then
  info "Refreshing Command Center frontend dependencies"
  (cd "$UCC" && npm install --no-audit --no-fund >/dev/null) && ok "Frontend dependencies ready" || warn "Frontend dependency install needs attention"
fi

if curl -fsS --max-time 2 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
  ok "Ollama is online"
elif command -v ollama >/dev/null 2>&1; then
  info "Starting Ollama"
  nohup ollama serve >"$LOGROOT/ollama.log" 2>"$LOGROOT/ollama-error.log" &
  wait_port 11434 20 && ok "Ollama started" || warn "Ollama did not start"
elif [[ -d /Applications/Ollama.app ]]; then
  open -a Ollama
  wait_port 11434 20 && ok "Ollama started" || warn "Ollama app opened but API is not ready"
else
  warn "Ollama is not installed"
fi

# Restart local API so newly-pulled routes/state code are actually loaded.
if port_up 3005; then
  info "Restarting LIV8 local API"
  pids="$(lsof -tiTCP:3005 -sTCP:LISTEN 2>/dev/null || true)"
  [[ -n "$pids" ]] && kill $pids >/dev/null 2>&1 || true
  sleep 1
fi
(cd "$UCC/server" && nohup node server.js >"$LOGROOT/ucc-api.log" 2>"$LOGROOT/ucc-api-error.log" & echo $! >"$HOME/.liv8/ucc-api.pid")
wait_port 3005 30 && ok "LIV8 local API is online" || warn "LIV8 local API failed; see $LOGROOT/ucc-api-error.log"

# Restart the Vite frontend too. New browser dependencies/routes otherwise stay
# stale even after git pull when the old dev server remains in memory.
if port_up 3002; then
  info "Restarting Command Center frontend"
  pids="$(lsof -tiTCP:3002 -sTCP:LISTEN 2>/dev/null || true)"
  [[ -n "$pids" ]] && kill $pids >/dev/null 2>&1 || true
  sleep 1
fi
(cd "$UCC" && nohup npm run dev -- --port 3002 >"$LOGROOT/ucc-web.log" 2>"$LOGROOT/ucc-web-error.log" & echo $! >"$HOME/.liv8/ucc-web.pid")
wait_port 3002 30 && ok "Command Center frontend is online" || warn "Command Center frontend failed; see $LOGROOT/ucc-web-error.log"

info "Installing/refreshing persistent Mac AI relay"
bash "$UCC/scripts/install-mac-ai-launchagent.sh" || warn "Mac AI relay install needs attention"

sleep 3
relay="$(curl -fsS --max-time 8 https://liv8-command-center-api.onrender.com/api/ai/mac-relay/status 2>/dev/null || true)"
if printf '%s' "$relay" | grep -q '"connected":true'; then
  ok "Mac Mini Ollama is connected to the installed/cloud Command Center"
else
  warn "Mac AI relay is not connected yet"
  if grep -q '^LIV8_MAC_BRIDGE_TOKEN=' "$UCC/server/.env" 2>/dev/null; then
    warn "Token exists locally; inspect $LOGROOT/mac-ai-worker-error.log"
  else
    warn "LIV8_MAC_BRIDGE_TOKEN is missing from $UCC/server/.env"
  fi
fi

printf '\n'
bash "$UCC/scripts/liv8-status" || true
